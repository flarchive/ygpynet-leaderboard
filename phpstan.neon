includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    level: 6
    paths:
        - extend.php
        - src
    excludePaths:
        - *.blade.php
    databaseMigrationsPath:
        - migrations
    ignoreErrors:
        - '#Negated boolean expression is always false#'
        - '#FoF\\Badges\\#'
        -
            message: '#nullsafe property access.*is unnecessary#'
            path: extend.php
